# Macrokite OS environment configuration
# Copy to .env.local and fill in values. Never commit real credentials.

# Leave MONGODB_URI empty (or unset) to run in browser demo mode (no sign-in, sample data).
# When set, data is stored server-side in MongoDB and everyone must sign in.
MONGODB_URI=
# Optional database name (defaults to the one in the URI, or "test").
MONGODB_DB=macrokite_os

# Sign-in (WorkOS AuthKit). Required in database mode. From https://dashboard.workos.com
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
# At least 32 characters; encrypts the session cookie. Generate with: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=
# Must match a redirect URI configured in the WorkOS dashboard.
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback

# Who may create a new workspace: comma-separated emails, or * for open sign-up. Empty = nobody.
# Everyone else joins through an invite from a workspace admin.
MACROKITE_WORKSPACE_CREATORS=

# Outgoing email over SMTP (optional). Used for invites when WorkOS can't send them, e.g. to
# someone who already has an account. Any SMTP provider works. Gmail: turn on 2-step verification,
# create an app password at https://myaccount.google.com/apppasswords and use it below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Optional sender, e.g. "Macrokite OS <you@gmail.com>". Defaults to SMTP_USER.
EMAIL_FROM=

# Time zone for meeting times in emails (IANA name, e.g. Asia/Dhaka). Defaults to UTC.
MACROKITE_TIME_ZONE=Asia/Dhaka

# Files and images in chat (Vercel Blob, private store). Create a Blob store in the Vercel project
# (Storage → Blob, access: Private) and copy its read-write token. Without it, sending files is off.
BLOB_READ_WRITE_TOKEN=

# Push notifications on phones and computers (Web Push). Generate a key pair once with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# The public key is also sent to browsers. Without these, the app works but sends no pushes.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for the push services: your site's URL or mailto:you@example.com.
VAPID_SUBJECT=
