# Macrokite OS environment configuration
# Copy to .env.local and fill in values. Never commit real credentials.

# Leave MONGODB_URI empty (or unset) to run in browser demo mode.
# When set, all data is stored server-side in MongoDB and seeded on first run.
MONGODB_URI=
# Optional database name (defaults to the one in the URI, or "test").
MONGODB_DB=macrokite_os

# Optional: which workspace and acting user (an active member; defaults to the first admin) the server uses. There is no authentication in this MVP;
# these values are server-side configuration, never read from requests.
MACROKITE_ORG_SLUG=macrokite
MACROKITE_ACTING_USER_EMAIL=
